{
  "name": "net-gui-workspace",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "bash start.sh",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "server:start": "bash start.sh",
    "desktop:install": "npm --prefix desktop install",
    "desktop:start": "npm --prefix desktop start",
    "desktop:build:mac": "npm --prefix desktop run build:mac",
    "desktop:build:win": "npm --prefix desktop run build:win",
    "desktop:pack": "npm --prefix desktop run pack",
    "sidecar:build": "backend/venv/bin/python scripts/build_sidecar.py",
    "test:backend": "backend/venv/bin/python backend/manage.py test apps.core apps.telemetry apps.ports apps.radar apps.runner apps.gateway apps.sniffer apps.landrop apps.switchboard apps.watchdog"
  }
}
